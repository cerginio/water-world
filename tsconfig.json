{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,

        "module": "esnext",
        "moduleResolution": "bundler",
        "target": "es2022",
        "lib": ["es2023", "dom", "dom.iterable"],
        "types": [],

        "strict": false,
        "skipLibCheck": true
    },
    "include": ["src/**/*.js", "src/types/*.d.ts"],
    "exclude": ["**/_archive/**", "**/dist/**", "**/.build-qa/**", "**/node_modules/**"]
}
